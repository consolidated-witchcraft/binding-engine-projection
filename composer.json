{
    "name": "consolidated-witchcraft/binding-engine-projection",
    "description": "A provenance-aware projection layer for transforming semantic assertions into graph-oriented semantic structures.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/consolidated-witchcraft/binding-engine-parser.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/consolidated-witchcraft/binding-engine-vocabulary.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/consolidated-witchcraft/binding-engine-vocabulary-loader.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/consolidated-witchcraft/binding-engine-assertions.git",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.4",
        "consolidated-witchcraft/binding-engine-parser": ">=0.1.0 <1.0.0",
        "consolidated-witchcraft/binding-engine-vocabulary": ">=0.1.0 <1.0.0",
        "consolidated-witchcraft/binding-engine-vocabulary-loader": ">=0.1.0 <1.0.0",
        "consolidated-witchcraft/binding-engine-assertions": ">=0.1.0 <1.0.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.80",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.4",
        "phpstan/phpstan": "^2.1",
        "symfony/var-dumper": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "ConsolidatedWitchcraft\\BindingEngine\\Projection\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "hooks:install": [
            "git config core.hooksPath .githooks",
            "chmod +x .githooks/pre-commit"
        ],
        "php-cs:check": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --verbose --sequential",
        "php-cs:fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --verbose --sequential",
        "test": "pest",
        "stan": "php -d memory_limit=1G vendor/bin/phpstan analyse"
    },
    "authors": [
        {
            "name": "Sam Baynham",
            "email": "sam.baynham@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
